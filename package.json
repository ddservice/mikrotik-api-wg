{
  "name": "mikrotik-dashboard",
  "version": "1.0.0",
  "description": "MikroTik Web Dashboard for Traffic Monitoring, Hotspot & Firewall Management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "preflight": "bash scripts/preflight-mikrotik-ecosystem.sh",
    "validate-html": "node scripts/validate-html.js",
    "check-db-parity": "node scripts/check-db-parity.js",
    "migrate-json-to-supabase": "node scripts/migrate-json-to-supabase.js",
    "cleanup-old-backups": "node scripts/cleanup-old-backups.js",
    "enable-dns-logging": "node scripts/enable-dns-logging.js",
    "build:frontend": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "rotate-api-password": "node scripts/rotate-mikrotik-api-password.js",
    "verify-pppoe-bytes": "node scripts/verify-pppoe-bytes.js",
    "test": "node test/run.js",
    "check": "npm run test && npm run validate-html && npm run check-db-parity"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": ">=2.49.4 <2.110.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "ws": "^8.18.0"
  }
}
