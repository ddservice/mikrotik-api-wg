node_modules/
.env
# ครอบทั้งโฟลเดอร์ db/ รวมโฟลเดอร์ย่อย — เดิมใช้ db/*.json ซึ่งไม่ครอบ
# db/backups-pre-restore/ ที่มี config.json (รหัสเราท์เตอร์) และ users.json
# (hash รหัสผ่าน dashboard) วางอยู่จริงบน VPS โดยไม่ถูก ignore เลย
# db.js สร้างโฟลเดอร์เองด้วย mkdirSync จึงไม่ต้องมีไฟล์ค้างไว้ให้ git
db/**
nas-backup.conf

# Next experiment build artifacts (Express is production — do not deploy .next)
.next/
tsconfig.tsbuildinfo

# PM2 config มี secret จริงบน VPS — ใช้ ecosystem.config.example.js เป็น template
ecosystem.config.js

# Log files
logs/*.log

# Local/offline pre-rewrite snapshots (may contain secrets)
backups/
.claude/

# Vue/Vite pilot — เฉพาะ node_modules เท่านั้นที่ไม่ track
# ตัว source ใน frontend/src และ build output ใน public/v2 ต้อง commit
# เพราะ VPS รัน `npm install --omit=dev` และไม่มี toolchain สำหรับ build
frontend/node_modules/
frontend/.vite/
# ไฟล์ log ปิดผนึกรายวัน (พรบ. ม.26) — เป็นข้อมูลจริงของแต่ละเครื่อง
# ต้นฉบับอยู่บน VPS + Cloudflare R2 ไม่ใช่ของที่ควรอยู่ใน git
archives/
dns-logs/
